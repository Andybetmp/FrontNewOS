# La empresa que se abre en desarrollo. En producción sale del subdominio o del
# acceso; aquí se fija a mano para no tener que escribirla en cada arranque.
VITE_EMPRESA=acme

# A dónde reenvía el proxy de Vite. Solo para desarrollo: en el navegador NUNCA
# aparece esta URL, porque todo sale del mismo origen por /api.
VITE_BACKEND_ORIGEN=http://localhost:8090

# ⚠️ La clave con la que el perfil `local` del backend firma sus tokens.
# NO se escribe aquí: se copia del application.yml del backend, donde vive a la
# vista y con su aviso. Sin ella, /dev/sesion no acuña nada y lo dice.
# Sin prefijo VITE_ A PROPÓSITO: así Vite no la expone al navegador.
CLAVE_LOCAL=
